# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps — native key (iOS Maps SDK + Android Maps SDK).
# Restrict in GCP to "Android apps" + "iOS apps" with this app's bundle id /
# package name / SHA-1.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Maps — web key (Maps JavaScript API). Falls back to
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY if unset. Restrict in GCP to
# "HTTP referrers" with the deployed web origin (+ localhost for dev).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_WEB=your-google-maps-web-api-key

# --- Supabase CLI / MCP only (not exposed to the app) ---
# SUPABASE_DB_PASSWORD=
# project_ref=

# --- Supabase Edge Function secrets (set via `supabase secrets set`) ---
# OPENAI_API_KEY=sk-...
# EXCHANGE_RATE_API_KEY=
